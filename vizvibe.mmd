    project_start("Inisiasi Proyek Perusahaan<br/><sub>Setup Next.js 16 App Router,<br/>konfigurasi Tailwind CSS v4,<br/>serta arsitektur SSG statis<br/>untuk web PT Cakra Indo Yuma</sub>")

    %% @core_features_impl [ai-task, closed, 2026-10-22, team]
    core_features_impl("Implementasi Halaman Inti<br/><sub>Pembuatan 5 halaman utama<br/>(Home, Tentang, Layanan, Proyek,<br/>Kontak), struktur data statis,<br/>dan navigasi responsif</sub>")

    %% @branding_visual_identity [ai-task, closed, 2026-10-23, team]
    branding_visual_identity("Branding & Identitas Visual<br/><sub>Penerapan logo resmi perusahaan,<br/>palet warna brand brown & gold,<br/>migrasi nama brand Alterior,<br/>serta ornamen chevron geometris</sub>")

    %% @portfolio_assets_integration [ai-task, closed, 2026-10-23, team]
    portfolio_assets_integration("Integrasi Portofolio Proyek<br/><sub>Penyusunan 30 proyek nyata,<br/>integrasi foto aset otentik,<br/>eliminasi duplikasi gambar, dan<br/>kartu arsip tanpa nilai kontrak</sub>")

    %% @content_privacy_refinement [ai-task, closed, 2026-10-24, team]
    content_privacy_refinement("Perapian Privasi & Profil<br/><sub>Penyelarasan halaman Tentang Kami,<br/>penghapusan ringkasan legalitas<br/>untuk perlindungan data sensitif,<br/>dan pembaruan metadata profil</sub>")

    %% @home_ui_tuning [ai-task, closed, 2026-10-24, team]
    home_ui_tuning("Penyesuaian UI Beranda<br/><sub>Optimasi Hero full viewport height,<br/>pembersihan badge dan gambar,<br/>perapian vertikal AboutSummary,<br/>serta eliminasi kartu visi</sub>")

    %% @whatsapp_formatting [ai-task, closed, 2026-11-05, team]
    whatsapp_formatting("Pembaruan Format WhatsApp<br/><sub>Penyempurnaan template pesan<br/>pada generator pesan WhatsApp<br/>di src/lib/whatsapp.ts agar lebih<br/>ringkas dan mudah dibaca admin</sub>")

    %% @project_assets_hygiene [ai-task, closed, 2026-11-07, team]
    project_assets_hygiene("Higienitas Aset Portofolio<br/><sub>Pembersihan duplikasi loker,<br/>penghapusan cover alat musik,<br/>eliminasi cover zoom pada RDP,<br/>dan konsistensi kartu bersih</sub>")

    %% @text_driven_project_cards [ai-task, closed, 2026-11-07, team]
    text_driven_project_cards("Redesain Kartu Non-Image<br/><sub>Transformasi kartu proyek ke<br/>format dossier rekam jejak B2B,<br/>menonjolkan instansi, status BAST,<br/>dan link detail spesifikasi</sub>")

    %% @photo_audit_and_copy_cleanup [ai-task, closed, 2026-11-07, team]
    photo_audit_and_copy_cleanup("Audit Foto & Perapian Teks<br/><sub>Penghapusan teks BAST di kartu,<br/>audit ketat kecocokan foto proyek,<br/>eliminasi foto filler & generic,<br/>dan verifikasi 12 proyek nyata</sub>")

    %% @client_showcase_deployment [ai-task, closed, 2026-11-16, team]
    client_showcase_deployment("Penyediaan Akses Klien<br/><sub>Aktivasi Cloudflare Quick Tunnel<br/>dengan HTTPS publik tanpa password,<br/>serta sinkronisasi commit ke GitHub<br/>untuk deployment cloud Vercel</sub>")

    %% @disconnect_public_access [ai-task, closed, 2026-11-16, team]
    disconnect_public_access("Pencabutan Akses Publik<br/><sub>Penonaktifan Cloudflare Tunnel,<br/>penghentian proses server Next.js,<br/>dan pengembalian lingkungan ke<br/>mode privat lokal sepenuhnya</sub>")

    %% === FUTURE WORK ===
    %% @seo_and_a11y_audit [ai-task, opened, 2026-11-05, team]
    seo_and_a11y_audit("Audit SEO & Aksesibilitas<br/><sub>Pemeriksaan target Lighthouse<br/>(>= 90 mobile, >= 95 a11y & SEO),<br/>validasi WCAG 2.1 AA, kontras,<br/>serta kelengkapan JSON-LD</sub>")

    %% @pdf_compro_download [ai-task, opened, 2026-11-05, team]
    pdf_compro_download("Fitur Unduh Company Profile<br/><sub>Penyediaan tombol unduh PDF<br/>profil perusahaan publik (P1)<br/>dengan ukuran di bawah 5 MB<br/>tanpa dokumen legalitas mentah</sub>")

    %% @e2e_testing_validation [ai-task, opened, 2026-11-05, team]
    e2e_testing_validation("Pengujian Interaktif & E2E<br/><sub>Uji coba filter direktori proyek,<br/>validasi formulir kontak Zod,<br/>fungsionalitas Lightbox galeri,<br/>dan konsistensi lintas layar</sub>")

